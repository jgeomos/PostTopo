+from __future__ import annotations
+
+import numpy as np
+import pandas as pd
+from joblib import Parallel, delayed
+
+try:
+    import cc3d
+except ImportError:          # scipy fallback in _label (slower)
+    cc3d = None
+
+AXES = 'zyx'                 # names of the grid axes in the descriptor names
+
+
+def _bounds(n, batch):
+    return [(i, min(i + batch, n)) for i in range(0, n, batch)]
+
+
+def _label(volume):
+    """
+    6-connected components of a non-negative integer volume, 0 = background. Components never span two
+    values, so that one call labels the bodies of all the classes of a model. Returns int64 labels, 0 for
+    the background, 1..n for the components.
+    """
+    if cc3d is not None:
+        return cc3d.connected_components(volume, connectivity=6).astype(np.int64, copy=False)
+    from scipy import ndimage
+    out, n = np.zeros(volume.shape, np.int64), 0
+    for v in np.unique(volume):
+        if v:
+            lab, k = ndimage.label(volume == v)            # default structure: 6-connectivity
+            out[lab > 0] = lab[lab > 0] + n
+            n += k
+    return out
+
+
+# ---------------------------------------------------------------------------
+# 0. Canonical codes
+# ---------------------------------------------------------------------------
+def _codes_batch(models, ref, K):
+    import motif_analysis as ma
+    out = np.empty(models.shape, np.uint8)
+    for i in range(models.shape[-1]):
+        out[..., i] = np.minimum(ma.canonical_labels(models[..., i], ref), 255)
+    return out
+
+
+def canonical_ensemble(models, reference, n_jobs=-1, batch=50):
+    """
+    Canonical unit codes of every model of an ensemble.
+
+    Parameters
+    ----------
+    models : (nz, ny, nx, N) ensemble (densities).
+    reference : reference model, or its codes from motif_analysis.reference_codes (same grid).
+
+    Returns
+    -------
+    codes : (nz, ny, nx, N) uint8. 0..K-1: reference units, by increasing mean depth (0 = top,
+        K-1 = deepest), as in motif_analysis; K, K+1, ...: the born units of each model (more than
+        255 - K born units in one model are merged in code 255). The identity of born units cannot be
+        followed from one model to the next: the indicators group them in one class K.
+    n_classes : K + 1 (reference units and the born class).
+
+    Memory: one byte per cell and model (e.g. 157 MB for 2000 models of 36 x 42 x 52 cells).
+
+    References
+    ----------
+    Unit matching by spatial overlap (motif_analysis.canonical_labels), a solution of the
+    label-switching problem of MCMC (Stephens, 2000).
+    """
+    import motif_analysis as ma
+    ref = ma.reference_codes(reference)
+    K = int(ref.max()) + 1
+    if K > 254:
+        raise ValueError(f"{K} reference units: uint8 codes hold at most 254")
+    N = models.shape[-1]
+    codes = np.empty(models.shape, np.uint8)
+    bounds = _bounds(N, batch)
+    res = Parallel(n_jobs=n_jobs, max_nbytes=None, return_as='generator')(
+        delayed(_codes_batch)(np.ascontiguousarray(models[..., i0:i1]), ref, K) for i0, i1 in bounds)
+    for (i0, i1), c in zip(bounds, res):
+        codes[..., i0:i1] = c
+    return codes, K + 1
+
+
+# ---------------------------------------------------------------------------
+# 1. Cell-wise indicators
+# ---------------------------------------------------------------------------
+def class_counts(codes, n_classes, groups=None):
+    """
+    Number of models of each group in which each cell belongs to each class.
+
+    Parameters
+    ----------
+    codes : (nz, ny, nx, N) integer codes; codes >= n_classes - 1 are counted in the last class (born).
+    groups : (N,) labels (chain, cluster, ...), or None for one group 'all'.
+
+    Returns
+    -------
+    counts : (G, n_classes, nz, ny, nx) int32.
+    names : (G,) group labels, sorted.
+    n : (G,) number of models per group.
+
+    One bincount per depth slice, so that the extra memory is one int64 index per cell of a slice and model.
+    """
+    nz, ny, nx, N = codes.shape
+    if groups is None:
+        names, gi = np.array(['all']), np.zeros(N, np.int64)
+    else:
+        names, gi = np.unique(np.asarray(groups), return_inverse=True)
+        gi = gi.reshape(-1).astype(np.int64)
+    G, nc = len(names), ny * nx
+    n = np.bincount(gi, minlength=G)
+    counts = np.empty((G, n_classes, nz, ny, nx), np.int32)
+    off = gi * n_classes                                  # (N,)
+    cell = np.arange(nc, dtype=np.int64)[:, None]         # (nc, 1)
+    for z in range(nz):
+        c = np.minimum(np.asarray(codes[z]).reshape(nc, N), n_classes - 1)
+        key = (off + c) * nc + cell                       # ((group, class), cell), row-major
+        counts[:, :, z] = np.bincount(key.ravel(), minlength=G * n_classes * nc).reshape(G, n_classes, ny, nx)
+    return counts, names, n
+
+
+def class_frequencies(codes, n_classes, groups=None):
+    """
+    Frequency p_k(x) of each class k at each cell x, per group: the fraction of the models of the group in
+    which x belongs to class k (Wellmann & Regenauer-Lieb, 2012). For a posterior ensemble, p_k(x) estimates
+    P(x in unit k | d). Returns (p (G, n_classes, nz, ny, nx) float32, names, n) as class_counts.
+    """
+    counts, names, n = class_counts(codes, n_classes, groups)
+    p = counts.astype(np.float32)
+    p /= np.maximum(n, 1).astype(np.float32)[:, None, None, None, None]
+    return p, names, n
+
+
+def pooled_frequencies(p, n):
+    """
+    Frequencies of all the models together from those of G groups: sum_g (n_g / N) p_g, with n_g the number
+    of models of group g and N = sum_g n_g. p: (G, n_classes, nz, ny, nx), n: (G,), as from class_frequencies.
+    Returns (n_classes, nz, ny, nx) float32, equal to class_frequencies without groups.
+    """
+    n = np.asarray(n, dtype=np.float64)
+    return np.tensordot(n / n.sum(), np.asarray(p, dtype=np.float64), axes=(0, 0)).astype(np.float32)
+
+
+def entropy_map(p):
+    """
+    Shannon entropy of the class frequencies at each cell (loopUI `entropy`; Shannon, 1948; Wellmann &
+    Regenauer-Lieb, 2012):
+
+        H(x) = - sum_k p_k(x) ln p_k(x),   with 0 ln 0 = 0,
+
+    where p_k(x) is the frequency of class k at cell x (class axis fourth from the end of p). H = 0 where all
+    models agree, ln(n_classes) at most. In nats; divide by ln 2 for bits.
+    """
+    p = np.asarray(p, dtype=np.float64)
+    t = np.zeros_like(p)
+    m = p > 0
+    t[m] = p[m] * np.log(p[m])
+    return -t.sum(axis=-4)
+
+
+def cardinality_map(p, p_min=0.0):
+    """
+    Number of classes with frequency above p_min at each cell (loopUI `cardinality`, p_min = 0). With
+    p_min = 0 the cardinality grows with the number of models, since a single model is enough to add a
+    class; p_min > 0 (e.g. 0.05) counts only the classes that a sizeable part of the ensemble supports.
+    """
+    return (np.asarray(p) > p_min).sum(axis=-4)
+
+
+def js_divergence_map(p, weights=None):
+    """
+    Generalised Jensen-Shannon divergence between the class frequencies of G groups at each cell
+    (Lin, 1991; loopUI `kldiv(..., 'js')` for two groups):
+
+        JS(x) = H( sum_g w_g p_g(x) ) - sum_g w_g H( p_g(x) ),
+
+    where p_g(x) is the vector of class frequencies of group g at cell x, w_g the weight of group g
+    (w_g >= 0, sum w_g = 1) and H the entropy of entropy_map. JS = 0 where all groups have the same
+    frequencies; JS <= ln G.
+
+    Parameters
+    ----------
+    p : (G, n_classes, nz, ny, nx), e.g. from class_frequencies with groups = chain ids.
+    weights : (G,) non-negative weights, normalised here; None = equal weights. With the numbers of models
+        per group (`n` of class_frequencies), w_g = n_g / N and JS(x) is the mutual information between the
+        group of a model and the class of cell x in the pooled ensemble; js_null_level then gives its value
+        expected from sampling alone.
+
+    Returns (nz, ny, nx).
+    """
+    p = np.asarray(p, dtype=np.float64)
+    G = p.shape[0]
+    w = np.full(G, 1.0 / G) if weights is None else np.asarray(weights, float) / np.sum(weights)
+    mix = np.tensordot(w, p, axes=(0, 0))
+    return np.maximum(entropy_map(mix) - np.tensordot(w, entropy_map(p), axes=(0, 0)), 0.0)
+
+
+def js_null_level(p_pooled, n, n_eff=None):
+    """
+    Value of js_divergence_map (with weights w_g = n_g / N) expected when all groups sample the same
+    distribution, from the finite number of models only:
+
+        E[JS(x)] ~= (c(x) - 1) / 2 * sum_g w_g (1 - w_g) / N_eff,g,
+
+    where c(x) is the number of classes present at cell x in the pooled ensemble (p_pooled: frequencies of
+    all the models together, (n_classes, nz, ny, nx)), n_g the number of models of group g, N = sum_g n_g,
+    w_g = n_g / N, and N_eff,g the effective sample size of group g (n_eff; n_g for independent models, see
+    effective_sample_size and chain_effective_sizes).
+
+    For independent models the level is (c - 1)(G - 1) / (2N), G being the number of groups: 2N JS(x) is
+    then the G-statistic of the test of homogeneity of the groups at x, asymptotically chi-square with
+    (c - 1)(G - 1) degrees of freedom (Wilks, 1938). The general form follows from the bias of the entropy
+    of estimated frequencies, -sum_k Var(p_k) / (2 p_k) to second order, where the frequencies of an
+    autocorrelated chain have the variance p_k (1 - p_k) / N_eff,g of N_eff,g independent models.
+
+    The approximation assumes large counts and underestimates the expected value where some classes occur in
+    few models: on the synthetic ensemble (random groups of one chain, 150 models), the mean JS is 1.16 times
+    the level. It is a reference level, not a test: JS(x) of several times the level marks cells where the
+    groups disagree beyond sampling noise.
+
+    Parameters
+    ----------
+    p_pooled : (n_classes, nz, ny, nx) frequencies of all the models.
+    n : (G,) numbers of models per group (`n` of class_frequencies).
+    n_eff : (G,) effective sample sizes, or None (= n, independent models).
+    """
+    n = np.asarray(n, dtype=float)
+    if n.ndim != 1 or n.size < 2:
+        raise ValueError("n must hold the numbers of models of the G >= 2 groups (the `n` of class_frequencies); "
+                         "the former signature js_null_level(p_pooled, n_groups, n_models) is no longer used")
+    n_eff = n if n_eff is None else np.asarray(n_eff, dtype=float)
+    w = n / n.sum()
+    c = cardinality_map(p_pooled)
+    return np.maximum(c - 1, 0) / 2.0 * float(np.sum(w * (1.0 - w) / n_eff))
+
+
+def effective_sample_size(x):
+    """
+    Effective sample size of a sequence x_1, ..., x_n of values along a chain (Geyer, 1992):
+
+        N_eff = n / tau,   tau = -1 + 2 sum_{m=0}^{M} Gamma_m,   Gamma_m = rho_{2m} + rho_{2m+1},
+
+    where rho_k is the lag-k autocorrelation of x (rho_0 = 1) and tau the integrated autocorrelation time. The
+    sum stops before the first Gamma_m <= 0 (initial positive sequence), and the Gamma_m are made
+    non-increasing (initial monotone sequence). N_eff = n for independent values; N_eff < n when each value
+    is correlated with the next ones. Capped at n; nan for a constant sequence, which tells nothing about the
+    autocorrelation.
+    """
+    x = np.asarray(x, dtype=np.float64)
+    n = x.size
+    if n < 4 or np.ptp(x) == 0:
+        return np.nan
+    y = x - x.mean()
+    f = np.fft.rfft(y, 2 * n)                               # zero padding: no circular wrap-around
+    acf = np.fft.irfft(f * np.conj(f), 2 * n)[:n]
+    acf /= acf[0]
+    m = (n - 1) // 2
+    gam = acf[0:2 * m:2] + acf[1:2 * m + 1:2]                # Gamma_0, ..., Gamma_{m-1}
+    stop = np.flatnonzero(gam <= 0)
+    gam = np.minimum.accumulate(gam[:stop[0]] if stop.size else gam)
+    tau = -1.0 + 2.0 * gam.sum()
+    return float(min(n, n / tau)) if tau > 0 else float(n)
+
+
+def chain_effective_sizes(codes, n_classes, groups=None, reference=None, order=None, class_names=None):
+    """
+    Effective sample size of each chain (group of models), from global summaries of each model followed along
+    the chain: the volume fraction of each class and, with reference codes, the fraction of cells whose class
+    differs from the reference unit (departure from the prior model). Configurations that persist along the
+    chain make all its summaries autocorrelated. The N_eff of a chain is the median of the N_eff of its
+    summaries (effective_sample_size); the smallest is also given, as a conservative bound. The estimate from
+    a single summary is noisy (about 10 % for 400 independent models), and the median is less affected by
+    that noise than the minimum. Cell-wise class indicators are not all as autocorrelated as the global
+    summaries, so that N_eff is a representative value for the chain, not a cell-by-cell one.
+
+    Thinning (saving one model out of k) reduces the autocorrelation between saved models but does not remove
+    it when configurations persist over more than k iterations.
+
+    Parameters
+    ----------
+    codes : (nz, ny, nx, N) canonical codes (canonical_ensemble).
+    groups : (N,) chain of each model, or None (one group).
+    reference : (nz, ny, nx) reference codes (motif_analysis.reference_codes), or None.
+    order : (N,) position of each model along its chain (e.g. index_in_chain of the saved models); None = the
+        order of the models in the ensemble.
+    class_names : names of the n_classes classes, for the table (default: 0..K-1 and 'born').
+
+    Returns a DataFrame with one row per group (sorted labels): n_models, N_eff (median over the summaries),
+    N_eff/n, the smallest N_eff and the summary giving it, and the median lag-1 autocorrelation of the
+    summaries.
+    """
+    nz, ny, nx, N = codes.shape
+    nc = ny * nx
+    cn = list(class_names) if class_names is not None else [str(k) for k in range(n_classes - 1)] + ['born']
+    off = (np.arange(N, dtype=np.int64) * n_classes)[None, :]
+    counts = np.zeros(N * n_classes, np.int64)
+    dep = np.zeros(N) if reference is not None else None
+    ref = None if reference is None else np.asarray(reference)
+    for z in range(nz):                                      # one pass per depth slice, all models at once
+        c = np.minimum(np.asarray(codes[z]).reshape(nc, N), n_classes - 1)
+        counts += np.bincount((off + c).ravel(), minlength=N * n_classes)
+        if ref is not None:
+            dep += (c != ref[z].reshape(nc, 1)).sum(0)
+    frac = counts.reshape(N, n_classes) / float(nz * nc)
+    series = [(f'fraction of {cn[k]}', frac[:, k]) for k in range(n_classes)]
+    if ref is not None:
+        series.append(('departure from the reference', dep / float(nz * nc)))
+    if groups is None:
+        names, gi = np.array(['all']), np.zeros(N, np.int64)
+    else:
+        names, gi = np.unique(np.asarray(groups), return_inverse=True)
+        gi = gi.reshape(-1)
+    order = np.arange(N) if order is None else np.asarray(order)
+    rows = []
+    for g in range(len(names)):
+        idx = np.flatnonzero(gi == g)
+        idx = idx[np.argsort(order[idx], kind='stable')]
+        ess, lag1, used = [], [], []
+        for name, v in series:
+            x = v[idx]
+            e = effective_sample_size(x)
+            if np.isfinite(e):                                  # constant summaries say nothing
+                ess.append(e)
+                lag1.append(float(np.corrcoef(x[:-1], x[1:])[0, 1]))
+                used.append(name)
+        n_g = len(idx)
+        if ess:
+            j = int(np.argmin(ess))
+            rows.append({'n_models': n_g, 'N_eff': float(np.median(ess)), 'N_eff/n': float(np.median(ess)) / n_g,
+                         'N_eff min': ess[j], 'smallest for': used[j], 'lag-1 autocorrelation': float(np.median(lag1))})
+        else:
+            rows.append({'n_models': n_g, 'N_eff': float(n_g), 'N_eff/n': 1.0, 'N_eff min': float(n_g),
+                         'smallest for': None, 'lag-1 autocorrelation': np.nan})
+    return pd.DataFrame(rows, index=pd.Index(names, name='group'))
+
+
+def kl_divergence_map(p, q, n_q, alpha=0.5):
+    """
+    Kullback-Leibler divergence of the class frequencies p (e.g. posterior) from q (e.g. prior) at each
+    cell (Kullback & Leibler, 1951):
+
+        D(x) = sum_k p_k(x) ln( p_k(x) / q~_k(x) ),   q~_k(x) = (n_q q_k(x) + alpha) / (n_q + alpha c),
+
+    where c is the number of classes, n_q the number of models behind q and alpha a pseudo-count (0.5:
+    Krichevsky & Trofimov, 1981), which keeps D finite where a class is absent from the prior sample. D is
+    the information gained on the unit at x from prior to posterior (Lindley, 1956): it detects a change of
+    the most probable unit even where the entropy does not decrease. Shapes of p and q as in entropy_map
+    (q broadcast to p).
+    """
+    p = np.asarray(p, dtype=np.float64)
+    q = np.asarray(q, dtype=np.float64)
+    c = p.shape[-4]
+    qs = np.broadcast_to((n_q * q + alpha) / (n_q + alpha * c), p.shape)
+    t = np.zeros_like(p)
+    m = p > 0
+    t[m] = p[m] * np.log(p[m] / qs[m])
+    return t.sum(axis=-4)
+
+
+def group_summary(p, names, n, mask=None, p_conf=0.95, born=False):
+    """
+    One row per group: number of models, mean entropy over the cells, fraction of uncertain cells (the most
+    frequent class has a frequency below p_conf) and mean cardinality with p_min = 0.05; with born=True (the
+    last class is the born class, as from canonical_ensemble), the mean probability of a born unit over the
+    cells, i.e. the expected fraction of the volume occupied by born units. mask: (nz, ny, nx) boolean, cells
+    taken into account (None: all). The mean entropy measures the spread of a cluster in unit geometry only,
+    whereas a standard deviation of densities mixes geometry and sampled densities.
+    """
+    sel = np.asarray(mask, bool) if mask is not None else Ellipsis
+    rows = []
+    for pg in p:                                          # one group at a time: memory of one group
+        rows.append((entropy_map(pg)[sel].mean(), (pg.max(axis=0)[sel] < p_conf).mean(),
+                     cardinality_map(pg, 0.05)[sel].mean(), pg[-1][sel].mean()))
+    H, unc, card, pb = np.array(rows).T
+    out = pd.DataFrame({'n_models': n, 'mean_entropy': H, 'frac_uncertain': unc, 'mean_cardinality': card},
+                       index=pd.Index(names, name='group'))
+    if born:
+        out['born_volume'] = pb
+    return out
+
+
+# ---------------------------------------------------------------------------
+# 2. Connectivity of density sets
+# ---------------------------------------------------------------------------
+def connectivity_gamma(mask):
+    """
+    Connectivity of a set of cells (Renard & Allard, 2013; loopUI `continuous_pct_connectivity`):
+
+        Gamma = sum_j (n_j / n)^2,
+
+    where n_j is the number of cells of the j-th 6-connected component of the set and n the number of cells
+    of the set. Gamma is the probability that two cells drawn at random in the set are connected: 1 for a
+    single body, about 1/m for m bodies of equal size. nan for an empty set (loopUI returns 0, which
+    would read as "disconnected").
+    """
+    s = np.bincount(_label(np.asarray(mask, dtype=np.uint8)).ravel())[1:].astype(np.float64)
+    n = s.sum()
+    return float((s ** 2).sum() / n ** 2) if n else np.nan
+
+
+def _gamma_batch(models, thresholds, above):
+    n, T = models.shape[-1], len(thresholds)
+    g, f = np.full((n, T), np.nan), np.zeros((n, T))
+    for i in range(n):
+        m = models[..., i]
+        for j, t in enumerate(thresholds):
+            s = m >= t if above else m < t
+            f[i, j] = s.mean()
+            g[i, j] = connectivity_gamma(s)
+    return g, f
+
+
+def gamma_curves(models, thresholds, above=True, n_jobs=-1, batch=50):
+    """
+    Connectivity curve Gamma(t) of every model: Gamma of the set of cells with density >= t (above=True)
+    or < t (above=False), for each threshold t, and the volume fraction of that set.
+
+    The thresholds are shared by all models (in density units), unlike loopUI, which thresholds each model
+    at its own percentiles: the curves of different models then describe the same rocks. For level-set
+    models, thresholds placed between the densities of the units select unions of units, e.g. all units
+    denser than the host, whatever their identity (reference or born).
+
+    Returns (gamma (N, T), volume fraction (N, T)); gamma is nan where the set is empty.
+    """
+    thresholds = list(np.atleast_1d(thresholds))
+    bounds = _bounds(models.shape[-1], batch)
+    res = Parallel(n_jobs=n_jobs, max_nbytes=None)(
+        delayed(_gamma_batch)(np.ascontiguousarray(models[..., i0:i1]), thresholds, above) for i0, i1 in bounds)
+    return np.vstack([r[0] for r in res]), np.vstack([r[1] for r in res])
+
+
+def class_densities(models, codes, n_classes, n_sample=50):
+    """
+    Densities of the classes over an evenly spaced sample of n_sample models: for each class, the number of
+    sampled models where it is present and the median, 5 % and 95 % quantiles and maximum of its density
+    (the median density of its cells in each model; for the born class, of all the born units together).
+    Used to place the thresholds of gamma_curves and connected_between between the units: a threshold
+    between the 95 % quantile of one unit and the 5 % quantile of the next selects the same units in every
+    model, whereas a threshold inside the range of a unit selects it in some models only.
+    """
+    N = models.shape[-1]
+    rows = [[] for _ in range(n_classes)]
+    for i in np.unique(np.linspace(0, N - 1, min(n_sample, N)).round().astype(int)):
+        c = np.minimum(np.asarray(codes[..., i]), n_classes - 1).ravel()
+        m = np.asarray(models[..., i]).ravel()
+        order = np.argsort(c, kind='stable')
+        bounds = np.searchsorted(c[order], np.arange(n_classes + 1))
+        for k in range(n_classes):
+            if bounds[k + 1] > bounds[k]:
+                rows[k].append(float(np.median(m[order[bounds[k]:bounds[k + 1]]])))
+    out = {k: dict(n_models=len(r), median=np.median(r), q05=np.quantile(r, 0.05), q95=np.quantile(r, 0.95),
+                   max=np.max(r)) if r else dict(n_models=0) for k, r in enumerate(rows)}
+    return pd.DataFrame.from_dict(out, orient='index').rename_axis('class')
+
+
+def box(shape, z=None, y=None, x=None):
+    """Boolean mask of a box of a (nz, ny, nx) grid: z, y, x are (start, stop) cell indices, None = whole axis."""
+    m = np.zeros(shape, bool)
+    m[tuple(slice(*r) if r is not None else slice(None) for r in (z, y, x))] = True
+    return m
+
+
+def _connected_batch(models, a, b, threshold, above):
+    out = np.zeros(models.shape[-1], bool)
+    for i in range(models.shape[-1]):
+        m = models[..., i]
+        lab = _label((m >= threshold if above else m < threshold).astype(np.uint8))
+        la, lb = np.unique(lab[a]), np.unique(lab[b])
+        out[i] = np.intersect1d(la[la > 0], lb[lb > 0], assume_unique=True).size > 0
+    return out
+
+
+def connected_between(models, region_a, region_b, threshold, above=True, n_jobs=-1, batch=50):
+    """
+    Indicator, for every model, of the hypothesis "a 6-connected body of cells with density >= threshold
+    (above=True; < threshold otherwise) reaches both region_a and region_b", e.g. "the southern and the
+    northern dense bodies are one body". region_a, region_b: boolean masks (nz, ny, nx), e.g. from box().
+    Returns a boolean array (N,), to be passed to motif_analysis.hypothesis_table.
+
+    The hypothesis concerns the set of dense cells, whatever the units they belong to (two dense born units
+    in contact are one body here, two bodies in motif_analysis). It extends the connectivity indicators of
+    loopUI and Renard & Allard (2013) from a summary of the set to a statement about given locations.
+    """
+    a, b = np.asarray(region_a, bool), np.asarray(region_b, bool)
+    bounds = _bounds(models.shape[-1], batch)
+    res = Parallel(n_jobs=n_jobs, max_nbytes=None)(
+        delayed(_connected_batch)(np.ascontiguousarray(models[..., i0:i1]), a, b, threshold, above)
+        for i0, i1 in bounds)
+    return np.concatenate(res)
+
+
+# ---------------------------------------------------------------------------
+# 3. Directional statistics of the classes of one model
+# ---------------------------------------------------------------------------
+def default_lags(shape, max_frac=0.5):
+    """Dyadic lags 1, 2, 4, ... (cells) up to max_frac of the length of each axis: {axis: (lags)}."""
+    out = {}
+    for a, n in enumerate(shape):
+        out[a] = tuple(2 ** i for i in range(64) if 2 ** i <= max_frac * n)
+    return out
+
+
+def _bodies(code):
+    """Bodies (6-connected components of each class) of one model of codes, labelled 1..n."""
+    return _label(np.asarray(code).astype(np.uint16) + 1)
+
+
+def class_gamma(code, n_classes, bodies=None):
+    """
+    Connectivity Gamma_k = sum_j (n_j / n_k)^2 of each class k of one model (connectivity_gamma applied to
+    the cells of class k), with n_j the number of cells of body j of class k and n_k the number of cells of
+    class k. 1 for a class made of one body; it decreases as the class breaks into pieces, which the capped
+    body counts of the topology key record only as integers. nan for an absent class. The bodies of the
+    born class are those of each born unit: two born units in contact are two bodies.
+    bodies: labels from _bodies(code), if already computed.
+    """
+    c = np.asarray(code)
+    b = (_bodies(c) if bodies is None else bodies).ravel()
+    size = np.bincount(b).astype(np.float64)
+    cls = np.zeros(size.size, np.int64)
+    cls[b] = np.minimum(c.ravel(), n_classes - 1)        # class of each body (all its cells agree)
+    nk = np.bincount(cls[1:], weights=size[1:], minlength=n_classes)
+    s2 = np.bincount(cls[1:], weights=size[1:] ** 2, minlength=n_classes)
+    with np.errstate(invalid='ignore', divide='ignore'):
+        return np.where(nk > 0, s2 / nk ** 2, np.nan)
+
+
+def lag_statistics(code, n_classes, lags=None, bodies=None):
+    """
+    Directional indicator variogram and connectivity function of each class of one model.
+
+    For class k, grid axis a (0 = depth, 1 = y, 2 = x) and lag h (cells), over the P pairs of cells
+    (x, x + h e_a) of the grid, where e_a is the unit vector of axis a and I_k(x) = 1 if cell x belongs
+    to class k and 0 otherwise:
+
+        gamma_k(h) = (1 / 2P) sum (I_k(x) - I_k(x + h e_a))^2       (indicator semi-variogram; Goovaerts, 1997)
+        tau_k(h)   = P( x ~ x + h e_a | I_k(x) = I_k(x + h e_a) = 1 )  (connectivity function; Renard & Allard, 2013)
+
+    where x ~ y means that x and y belong to the same body (6-connected component of one unit; for the born
+    class, of one born unit). gamma_k(h)
+    rises from 0 to p_k(1 - p_k), p_k being the volume fraction of class k, over a distance that measures
+    the size of its bodies along axis a; tau_k(h) = 1 for a class made of one body and decreases with h
+    when the class is split into bodies smaller than h.
+
+    All pairs are used (no sampling, unlike loopUI), from counts over the shifted grids:
+    gamma_k = (n_k^- + n_k^+ - 2 n_kk) / (2P) and tau_k = n_kk^conn / n_kk, where n_k^- and n_k^+ are the
+    numbers of pairs whose first and second cell are in class k, n_kk those with both cells in class k, and
+    n_kk^conn those with both cells in the same body of class k.
+
+    Parameters
+    ----------
+    code : (nz, ny, nx) canonical codes of one model.
+    lags : {axis: sequence of lags in cells}; None = default_lags(code.shape). Lags of the same physical
+        length along axes with different cell sizes are obtained by dividing by the cell size.
+    bodies : labels from _bodies(code), if already computed.
+
+    Returns
+    -------
+    vario, tau : dicts {axis: (n_classes, n_lags) array}; tau is nan where no pair lies in class k.
+    """
+    c = np.asarray(code)
+    b = _bodies(c) if bodies is None else bodies          # bodies of each unit (born units distinct)
+    c = np.minimum(c, n_classes - 1)                      # classes (born units grouped)
+    lags = default_lags(c.shape) if lags is None else lags
+    vario, tau = {}, {}
+    for a, hs in lags.items():
+        V = np.full((n_classes, len(hs)), np.nan)
+        T = np.full((n_classes, len(hs)), np.nan)
+        n = c.shape[a]
+        for j, h in enumerate(hs):
+            if not 0 < h < n:
+                continue
+            lo, hi = [slice(None)] * 3, [slice(None)] * 3
+            lo[a], hi[a] = slice(0, n - h), slice(h, n)
+            ca, cb = c[tuple(lo)].ravel(), c[tuple(hi)].ravel()
+            same = ca == cb
+            n_lo = np.bincount(ca, minlength=n_classes)
+            n_hi = np.bincount(cb, minlength=n_classes)
+            n_kk = np.bincount(ca[same], minlength=n_classes)
+            n_conn = np.bincount(ca[b[tuple(lo)].ravel() == b[tuple(hi)].ravel()], minlength=n_classes)
+            V[:, j] = (n_lo + n_hi - 2 * n_kk) / (2.0 * ca.size)
+            with np.errstate(invalid='ignore', divide='ignore'):
+                T[:, j] = np.where(n_kk > 0, n_conn / n_kk, np.nan)
+        vario[a], tau[a] = V, T
+    return vario, tau
+
+
+# ---------------------------------------------------------------------------
+# 4. Per-model descriptors
+# ---------------------------------------------------------------------------
+def descriptor_names(n_classes, lags, class_names=None):
+    """Names of the columns of descriptor_table, in order (class names default to 0..K-1 and 'born')."""
+    cn = list(class_names) if class_names is not None else [str(k) for k in range(n_classes - 1)] + ['born']
+    names = [f'frac_{k}' for k in cn] + [f'Gamma_{k}' for k in cn]
+    for stat in ('vario', 'tau'):
+        for a in sorted(lags):
+            names += [f'{stat}_{k}_{AXES[a]}{h}' for k in cn for h in lags[a]]
+    return names
+
+
+def model_descriptors(code, n_classes, lags, normalise=True):
+    """
+    Descriptor vector of one model: volume fraction f_k and Gamma_k of each class k, then the variogram
+    and tau_k(h) for each axis, class and lag (order of descriptor_names). With normalise=True, the
+    variogram is divided by its sill f_k (1 - f_k), so that it rises from 0 to about 1 over the size of
+    the bodies of class k along the axis and carries their length scale, not their proportion (already in
+    f_k). Gamma and tau of an absent class, tau where no pair lies in the class, and the normalised
+    variogram of an absent class (or of a class filling the grid) are set to 0, so that every model has a
+    finite vector.
+    """
+    c = np.asarray(code)
+    b = _bodies(c)
+    frac = np.bincount(np.minimum(c, n_classes - 1).ravel(), minlength=n_classes) / c.size
+    vario, tau = lag_statistics(c, n_classes, lags, b)
+    if normalise:
+        sill = frac * (1.0 - frac)
+        with np.errstate(invalid='ignore', divide='ignore'):
+            vario = {a: np.where(sill[:, None] > 0, v / sill[:, None], 0.0) for a, v in vario.items()}
+    parts = [frac, class_gamma(c, n_classes, b)]
+    parts += [vario[a].ravel() for a in sorted(lags)] + [tau[a].ravel() for a in sorted(lags)]
+    return np.nan_to_num(np.concatenate(parts), nan=0.0)
+
+
+def _descriptor_batch(codes, n_classes, lags, normalise):
+    return np.stack([model_descriptors(codes[..., i], n_classes, lags, normalise) for i in range(codes.shape[-1])])
+
+
+def descriptor_table(codes, n_classes, lags=None, class_names=None, normalise=True, n_jobs=-1, batch=50):
+    """
+    Descriptor vectors of all the models of an ensemble of codes, as a DataFrame (N rows, one column per
+    descriptor, named by descriptor_names): volume fractions (frac_), connectivity of each class
+    (Gamma_), directional indicator variograms (vario_<class>_<axis><lag>; divided by the sill with
+    normalise=True, see model_descriptors) and connectivity functions (tau_<class>_<axis><lag>). Cost linear in N: about one connected-component pass and a few counts per
+    lag per model, against N(N - 1)/2 comparisons for the pairwise distances of loopUI.
+
+    Groups of columns for block_distance_correlation or for weighting in an embedding:
+    X.filter(regex='^frac_'), '^Gamma_', '^vario_', '^tau_'.
+    """
+    nz, ny, nx, N = codes.shape
+    lags = default_lags((nz, ny, nx)) if lags is None else {a: tuple(h for h in hs if 0 < h < (nz, ny, nx)[a])
+                                                             for a, hs in lags.items()}
+    bounds = _bounds(N, batch)
+    res = Parallel(n_jobs=n_jobs, max_nbytes=None)(
+        delayed(_descriptor_batch)(np.ascontiguousarray(codes[..., i0:i1]), n_classes, lags, normalise)
+        for i0, i1 in bounds)
+    return pd.DataFrame(np.vstack(res).astype(np.float32), columns=descriptor_names(n_classes, lags, class_names))
+
+
+# ---------------------------------------------------------------------------
+# 5. Redundancy between descriptor blocks
+# ---------------------------------------------------------------------------
+def block_distance_correlation(blocks, n_sub=500, metric='euclidean', seed=0, standardise=True):
+    """
+    Rank correlation between the distances that different descriptor blocks give to the same pairs of
+    models, the matrix counterpart of the cross-plots of indicators of loopUI (ui-9-comparison).
+
+    For each block (e.g. 'CNN', 'topological', 'petrophysical' of ensemble_features, and the groups of
+    columns of descriptor_table), the distances between the models of a common random subset of n_sub
+    models are computed (scipy pdist, after standardising each column within the subset), and the
+    Spearman correlation between the n_sub (n_sub - 1) / 2 distances of every two blocks is returned
+    (Mantel, 1967). A correlation close to 1 means that two blocks rank the pairs of models alike, i.e.
+    that one adds little to the other in an embedding; a low correlation means that they see different
+    differences between models. No p-value is given: the distances of a matrix are not independent.
+
+    Parameters
+    ----------
+    blocks : dict {name: (N, F) array or DataFrame}, same models in the same order.
+    metric : distance passed to pdist ('euclidean', 'cosine', ...).
+
+    Returns a DataFrame (blocks x blocks).
+    """
+    from scipy.spatial.distance import pdist
+    from scipy.stats import rankdata
+    names = list(blocks)
+    N = len(blocks[names[0]])
+    idx = np.sort(np.random.default_rng(seed).choice(N, size=min(n_sub, N), replace=False))
+    ranks = []
+    for k in names:
+        X = np.asarray(blocks[k], dtype=np.float64)[idx]
+        if standardise:
+            s = X.std(0)
+            X = (X - X.mean(0)) / np.where(s > 0, s, 1.0)
+        ranks.append(rankdata(pdist(X, metric=metric)))
+    return pd.DataFrame(np.corrcoef(np.vstack(ranks)), index=names, columns=names)
+
+
+# ---------------------------------------------------------------------------
+# 6. Figure
+# ---------------------------------------------------------------------------
+def plot_sections(vol, title='', iz=None, iy=None, ix=None, cmap='viridis', vmin=None, vmax=None,
+                  cell_sizes=None, label='', axes=None):
+    """
+    Map at depth index iz and vertical sections at iy (x-depth) and ix (y-depth) of a cell-wise volume
+    (nz, ny, nx), e.g. an entropy or divergence map. Defaults: a quarter of the depth, middle of y and x.
+    cell_sizes = (dz, dy, dx) gives axes in metres and true proportions; None: cells. Returns the figure.
+    """
+    import matplotlib.pyplot as plt
+    vol = np.asarray(vol)
+    nz, ny, nx = vol.shape
+    iz = nz // 4 if iz is None else iz
+    iy = ny // 2 if iy is None else iy
+    ix = nx // 2 if ix is None else ix
+    dz, dy, dx = (1.0, 1.0, 1.0) if cell_sizes is None else cell_sizes
+    u = 'cells' if cell_sizes is None else 'm'
+    panels = [(vol[iz], f'map, depth index {iz}', 'lower', (0, nx * dx, 0, ny * dy), 'x', 'y'),
+              (vol[:, iy, :], f'section y index {iy}', 'upper', (0, nx * dx, nz * dz, 0), 'x', 'depth'),
+              (vol[:, :, ix], f'section x index {ix}', 'upper', (0, ny * dy, nz * dz, 0), 'y', 'depth')]
+    if axes is None:
+        fig, axes = plt.subplots(1, 3, figsize=(14, 3.8), constrained_layout=True)
+    fig = axes[0].figure
+    vmin = np.nanmin(vol) if vmin is None else vmin
+    vmax = np.nanmax(vol) if vmax is None else vmax
+    for ax, (img, t, org, ext, xl, yl) in zip(axes, panels):
+        im = ax.imshow(img, origin=org, extent=ext, cmap=cmap, vmin=vmin, vmax=vmax, interpolation='nearest')
+        ax.set_title(t, fontsize=9)
+        ax.set_xlabel(f'{xl} ({u})', fontsize=8)
+        ax.set_ylabel(f'{yl} ({u})', fontsize=8)
+        ax.tick_params(labelsize=7)
+    fig.colorbar(im, ax=list(axes), fraction=0.02, pad=0.01).set_label(label, fontsize=8)
+    if title:
+        fig.suptitle(title, fontsize=11)
+    return fig
